# DPS variant of a MUR module image.
#
# WHY THIS EXISTS
#   1. ENTRYPOINT collides with CWL. The module images set
#      ENTRYPOINT ["/opt/<module>/bin/entrypoint.sh"], which is right for
#      `docker run <image> --year 2026 ...` as run_mur_pipeline.py invokes
#      them. But CWL supplies `baseCommand`, and Docker APPENDS a command to
#      ENTRYPOINT rather than replacing it -- so a CWL job would execute
#
#          entrypoint.sh /opt/landice/bin/entrypoint.sh --year 2026 ...
#
#      and every MUR entrypoint rejects unknown positional args with
#      "ERROR: Unknown argument", exiting 1. (MAAP's own stac_clip reference
#      Containerfile declares no ENTRYPOINT for exactly this reason.)
#
#   2. It refreshes the shell scripts. entrypoint.sh and localize.sh are
#      COPY'd in the FINAL layer of every module image, after the MATLAB
#      Runtime install -- so overwriting them here picks up changes without
#      recompiling anything. That matters because an image built before the
#      MUR_OUTPUT_ROOT stage-out fix writes to absolute paths CWL cannot
#      collect, and would otherwise need a full MATLAB rebuild (licence
#      server, ~30 minutes) just to change a bash script.
#
#   Both are metadata and text: the MATLAB Runtime, the compiled binaries and
#   the Fortran executables are all inherited unchanged from the base image.
#
# BUILD
#   Use utils/build_dps_images.sh, which builds all four with the right
#   MODULE arg and repo-root context:
#
#     docker build -f maap/Dockerfile.dps \
#       --build-arg BASE_IMAGE=ghcr.io/podaac/mur/landice:2.0.0 \
#       --build-arg MODULE=landice \
#       -t ghcr.io/podaac/mur/landice-dps:2.0.0 .
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Repeated after FROM: an ARG declared before it is out of scope afterwards.
ARG MODULE

# Identifies this exact build. A tag rebuilt in place is indistinguishable
# from the old one on any host that already pulled it -- cwltool only runs
# `docker pull` when `docker inspect` of the tag FAILS, so a DPS worker that
# has run this tag before keeps using its cached copy forever. The entrypoint
# echoes this, so a job log answers "which build actually ran" as a fact
# instead of an assumption. build_dps_images.sh fills it from git.
ARG BUILD_STAMP=unknown
ENV MUR_IMAGE_BUILD=${BUILD_STAMP}
LABEL org.opencontainers.image.revision="${BUILD_STAMP}"

# Refresh the entrypoint and the localization helper from the working tree.
# iquam neither installs awscli nor sources localize.sh, so its copy is inert
# -- a few KB, and it keeps this one Dockerfile serving all four modules.
USER root
COPY common/bin/localize.sh /opt/common/bin/localize.sh
COPY ${MODULE}/bin/entrypoint.sh /opt/${MODULE}/bin/entrypoint.sh
RUN chmod 0755 /opt/common/bin/localize.sh /opt/${MODULE}/bin/entrypoint.sh

# NO `USER matlab` HERE, though an earlier version of this file had one.
# `USER matlab` appears in every module Dockerfile, but in the BUILDER stage
# -- the runtime stage is `FROM debian:bookworm-slim` and creates no users at
# all, so the module images run as root and have no matlab account. Declaring
# it here produced an image that could not start:
#
#     unable to find user matlab: no matching entries in passwd file
#
# Docker validates USER at run time, not build time, so the build succeeded
# and every container made from it failed. Leave the base image's user alone.
# DPS may override the UID anyway, which is why the entrypoints create their
# own directories and mrva's stage-out has a copy fallback.

# CWL supplies the command via baseCommand; an ENTRYPOINT would prefix it.
ENTRYPOINT []

# No CMD either: CWL always supplies one, and a stray default would run if a
# human invoked this image bare, which should instead fail loudly.
CMD []
